---
import { Image } from "astro:assets";
import Title from "../../../components/title.astro";
import decorImg from "../../../assets/images/decor/culture.webp";
import videoPoster from "./assets/culture-preview.webp";
import PlayButton from "../../../assets/images/play-button.svg";
import Container from "../../../components/container.astro";

const videoEmbedSrc =
  "https://vkvideo.ru/video_ext.php?oid=-220924762&id=456239223&list=ln-EJXdPU6QK5YVMxqxsx&uh=e61efbabdfd736&hd=4&autoplay=1";
---

<section class="culture" aria-labelledby="culture-title">
  <Container>
    <Title title="h3" id="culture-title">
      <span class="culture__title">
        Топ-менеджеры — <br />о&nbsp;культуре в&nbsp;команде
      </span>
      <Image
        slot="image"
        src={decorImg}
        class="title-img"
        width="145"
        height="145"
        layout="fixed"
        alt=""
        loading="lazy"
      />
    </Title>

    <div class="culture__media" data-reveal data-video-player>
      <iframe
        class="culture__video"
        data-video-player-iframe
        data-src={videoEmbedSrc}
        title="Видео о культуре в команде"
        width="1920"
        height="1080"
        allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
        hidden
        allowfullscreen></iframe>

      <button
        class="culture__playback"
        type="button"
        aria-label="Запустить видео"
        data-video-player-playback
      >
        <Image
          src={videoPoster}
          class="culture__poster"
          alt=""
          loading="lazy"
        />
        <span class="culture__play-icon"><PlayButton /></span>
      </button>
    </div>
  </Container>

  <style>
    .culture {
      /* desktop */
      @media (width >= 960px) {
        margin-top: -50px;
      }

      /* widescreen */
      @media (width >= 1200px) {
        margin-top: -70px;
      }

      & .culture__title {
        letter-spacing: -0.5px;

        /* desktop */
        @media (width >= 960px) {
          letter-spacing: -1px;
        }

        /* widescreen */
        @media (width >= 1200px) {
          letter-spacing: 0;
        }

        /* fullhd */
        @media (width >= 1600px) {
          padding-right: 15%;
        }
      }

      & .title-img {
        transform-origin: right top;
        transform: rotate(-25deg) scale(0.75);

        /* desktop */
        @media (width >= 960px) {
          width: 120px;
          height: 120px;
        }

        /* widescreen */
        @media (width >= 1200px) {
          transform: rotate(-25deg) scale(1);
          transform-origin: center;
        }

        @media (width >= 1300px) {
          width: 145px;
          height: 145px;
          transform: rotate(-25deg) scale(1);
        }
      }

      & .culture__media {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        aspect-ratio: 1920 / 1080;
        max-width: calc(60vh * 1920 / 1080);
        margin-top: var(--space32);
        margin-inline: auto;
        overflow: hidden;
        border-radius: 20px;
        background-color: #071b49;
      }

      & .culture__video {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 1920 / 1080;
        border: 0;
        border-radius: inherit;
      }

      & .culture__video[hidden],
      & .culture__playback[hidden] {
        display: none;
      }

      & .culture__poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      & .culture__playback {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--color-text-primary);
        cursor: pointer;
        transition: color var(--transition);
      }

      & .culture__playback:hover {
        color: var(--color-primary);
      }

      & .culture__play-icon {
        position: relative;
        font-size: 0;
      }

      & .culture__playback:focus-visible {
        outline: 2px solid var(--color-text-primary);
        outline-offset: -4px;
      }

      @media (width >= 960px) {
        & .culture__media {
          margin-top: var(--space44);
        }

        & .culture__playback svg {
          width: 72px;
          height: 82px;
        }
      }

      /* fullhd */
      @media (width >= 1600px) {
        & .culture__media {
          margin-top: 75px;
        }
      }
    }
  </style>
</section>
