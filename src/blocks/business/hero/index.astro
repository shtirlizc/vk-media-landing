---
import { Image } from "astro:assets";
import decorImg from "./assets/decor.webp";
import videoPoster from "./assets/buisness-video-preview.webp";
import PlayButton from "../../../assets/images/play-button.svg";
import Container from "../../../components/container.astro";

const videoEmbedSrc =
  "https://vkvideo.ru/video_ext.php?oid=-220924762&id=456239222&hash=092a212818664dce&hd=3&autoplay=1";
---

<section class="hero" aria-labelledby="hero">
  <Container>
    <div class="hero__copy">
      <p class="hero__eyebrow">Бизнес-группа</p>

      <h1 class="hero__title">«Социальные платформы и медиаконтент»</h1>

      <p class="hero__description">
        Мы — большая часть VK. Создаём и развиваем соцсети, медиасервисы
        и развлекательные проекты.
      </p>
    </div>
  </Container>

  <Image
    class="hero__decor"
    src={decorImg}
    width={1494}
    height={1465}
    widths={[291, 582, 619, 747, 1238, 1494]}
    sizes="(min-width: 1200px) 747px, (min-width: 960px) 619px, 291px"
    alt=""
  />

  <Container>
    <div class="hero__media" data-video-player>
      <iframe
        class="hero__video"
        data-video-player-iframe
        data-src={videoEmbedSrc}
        title="Видео о бизнес-группе"
        width="1920"
        height="1080"
        allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
        hidden
        allowfullscreen></iframe>

      <button
        class="hero__playback"
        type="button"
        aria-label="Запустить видео"
        data-video-player-playback
      >
        <Image src={videoPoster} class="hero__poster" alt="" loading="lazy" />
        <span class="hero__play-icon"><PlayButton /></span>
      </button>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    width: 100%;
    padding: var(--space48) 0 5px;

    /* desktop */
    @media (width >= 960px) {
      padding: 65px 0 15px;
    }

    /* widescreen */
    @media (width >= 1200px) {
      padding: 125px 0 15px;
    }

    &::before {
      content: "";
      position: absolute;
      top: 100px;
      left: 50%;
      transform: translate(-50%);
      width: 29627px;
      height: 29761px;
      background: radial-gradient(
        93.7% 32.19% at 50.49% 25.96%,
        #01389200 78.75%,
        #f3f8ff 79.93%,
        #f3f7ff17 80.61%,
        #d7e6ff4d 95.9%
      );
      border: 80px solid #0162ff;
      filter: blur(40px);

      /* desktop */
      @media (width >= 960px) {
        border: 150px solid #0162ff;
        filter: blur(50px);
      }
    }

    & .hero__copy {
      position: relative;
      z-index: 2;
      width: 100%;
      text-align: center;

      /* desktop */
      @media (width >= 960px) {
        min-height: 50vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
    }

    & .hero__eyebrow {
      margin-bottom: var(--space16);
      font-size: 16px;
      text-align: center;
    }

    & .hero__title {
      font-size: 24px;
      font-weight: 700;
      line-height: 90%;
      text-align: center;
      text-transform: lowercase;
    }

    & .hero__description {
      margin: var(--space20) auto 0;
      font-size: 16px;
      line-height: 100%;
      text-align: center;
      letter-spacing: -0.3px;
    }

    & .hero__decor {
      align-self: flex-end;
      width: 291px;
      height: auto;
      z-index: 1;
      margin-top: -20px;
      pointer-events: none;
    }

    & .hero__media {
      position: relative;
      z-index: 3;
      width: 100%;
      margin-top: -170px;
      margin-inline: auto;
      aspect-ratio: 1920 / 1080;
      max-width: calc(70vh * 1920 / 1080);
      overflow: hidden;
      border-radius: 20px;
      display: grid;
      place-items: center;
    }

    & .hero__video {
      display: block;
      width: 100%;
      height: 100%;
      aspect-ratio: 1920 / 1080;
      border: 0;
      border-radius: inherit;
    }

    & .hero__video[hidden],
    & .hero__playback[hidden] {
      display: none;
    }

    & .hero__poster {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    & .hero__playback {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
      color: var(--color-text-primary);
      transition: color var(--transition);
    }

    & .hero__playback:hover {
      color: var(--color-primary);
    }

    & .hero__play-icon {
      position: relative;
      font-size: 0;
    }

    & .hero__playback:focus-visible {
      outline: 2px solid var(--color-text-primary);
      outline-offset: -4px;
    }
  }

  /* desktop */
  @media (width >= 960px) {
    .hero {
      &::before {
        top: 200px;
      }

      & .hero__eyebrow {
        margin-bottom: var(--space32);
        font-size: 24px;
      }

      & .hero__title {
        font-size: 44px;
      }

      & .hero__description {
        margin-top: var(--space28);
        font-size: 24px;
        max-width: 800px;
        letter-spacing: -1px;
      }

      & .hero__playback svg {
        width: 72px;
        height: 82px;
      }

      & .hero__decor {
        width: 619px;
        margin-top: -92px;
      }

      & .hero__media {
        margin-top: -350px;
        width: calc(100% - 30px);
      }
    }
  }

  /* widescreen */
  @media (width >= 1200px) {
    .hero {
      & .hero__decor {
        width: 747px;
        margin-top: -38px;
      }

      & .hero__eyebrow {
        font-size: 26px;
      }

      & .hero__description {
        font-size: 26px;
      }

      & .hero__title {
        font-size: 60px;
      }

      & .hero__media {
        margin-top: -442px;
        min-width: min(1121px, calc(70vh * 1920 / 1080));
      }
    }
  }

  /* fullhd */
  @media (width >= 1600px) {
    .hero {
      & .hero__decor {
        width: 1040px;
        margin-top: -290px;
      }

      & .hero__eyebrow {
        font-size: 36px;
        margin-bottom: var(--space40);
      }

      & .hero__description {
        font-size: 36px;
        margin-top: var(--space40);
      }

      & .hero__title {
        font-size: 72px;
      }
    }
  }
</style>
