---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Title from "../../../components/title.astro";
import decorImg from "../../../assets/images/decor/people.webp";
import Container from "../../../components/container.astro";
import PlayButton from "../../../assets/images/play-button.svg";
import CloseIcon from "../../../assets/images/x.svg";
import { getVideoSrc } from "../../../utils/getVideoSrc.ts";

const copies = [0, 1, 2, 3];
const peoplePhotos = import.meta.glob<{ default: ImageMetadata }>(
  "./photos/*.webp",
  { eager: true },
);
const peopleVideoNames = [
  "01-01-oleg-nikitin",
  "01-02-natalya-bezrodnaya",
  "01-03-yaroslav-kindsfater",
  "01-05-kristina-zolotykh",
  "02-02-ekaterina-efimova",
  "02-03-vladimir-veselov",
  "02-04-elizaveta-pavlova",
  "02-05-daniil-kurpachenko",
  "02-06-sergey-voskoboynikov",
  "02-07-daniil-samoylov",
  "02-08-aleksandr-popov",
  "03-01-anastasiya-romanova",
  "03-02-ekaterina-komissarova",
  "03-03-ivan-kharlamov",
  "03-04-ksenia-varenik",
  "03-05-anna-kosareva",
  "03-06-alisa-kolesnikova",
  "03-07-daniil-kamenev",
  "03-08-nikolay-koroteev",
  "03-09-natalya-boronenkova",
  "03-10-evgeniy-krotov",
  "03-11-ekaterina-orlova",
  "04-01-nadezhda-fateeva",
  "04-02-mark-khabarov",
  "04-03-inessa-zabelina",
  "04-04-aleksey-krikunov",
  "04-05-eduard-kovtun",
  "04-06-dina-bezuglaya",
  "04-07-daniil-korolyov",
  "04-08-mariya-avdeeva",
  "04-09-pyotr-kuzmin",
  "04-10-darya-lunyova",
  "04-11-konstantin-izvekov",
  "05-01-igor-rusyaev",
  "05-02-kamilla-kiyashova",
  "05-03-polina-kuralesova",
  "05-04-vladimir-doronin",
  "05-05-milana-vozba",
  "05-06-galina-shirankova",
  "06-01-darya-rabotskaya",
  "06-02-vladimir-elenkov",
  "06-03-anastasiya-rakova",
  "06-04-sergey-kolesnikov",
  "06-05-ivan-ostapenko",
  "06-06-evgenia-voronina",
  "06-06-kirill-inyakin",
  "06-07-vitaliy-smirnov",
  "06-08-konstantin-tkachenko",
  "06-09-mikhail-gamayunov",
  "06-10-kristina-khalatova",
  "06-11-aleksandr-kharkov",
  "06-12-elina-ismaeva",
  "06-13-zarina-akeneva",
];

const people = peopleVideoNames.map((name) => {
  const displayName = name
    .split("-")
    .slice(2)
    .map((part) => `${part[0].toUpperCase()}${part.slice(1)}`)
    .join(" ");

  return {
    displayName,
    photo: peoplePhotos[`./photos/${name}.webp`].default,
    video: getVideoSrc(name),
  };
});

const peopleRows = Array.from({ length: 3 }, (_, rowIndex) =>
  people.filter((_, personIndex) => personIndex % 3 === rowIndex),
);
---

<div class="people">
  <Container>
    <Title id="people-title">
      <span class="people__title">Главное — люди</span>
      <Image
        class="title-img"
        slot="image"
        src={decorImg}
        width="135"
        height="135"
        layout="fixed"
        alt=""
        loading="lazy"
      />
    </Title>
  </Container>

  <div class="people__marquee" data-reveal>
    {
      peopleRows.map((row) => (
        <div class="people__row">
          <div class="people__track">
            {copies.map((copyIndex) => (
              <div
                class="people__group"
                aria-hidden={copyIndex > 0 ? "true" : undefined}
              >
                {row.map((person) => (
                  <button
                    type="button"
                    data-video={person.video}
                    class="people__photo"
                    tabindex={copyIndex > 0 ? "-1" : undefined}
                  >
                    <Image
                      class="people__photo-image"
                      src={person.photo}
                      alt={person.displayName}
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <div popover class="_modal" id="popover-people">
      <video playsinline preload="none"></video>
      <button
        class="_modal__playback"
        type="button"
        aria-label="Поставить видео на паузу"
        data-people-playback
      >
        <span class="_modal__play-icon"><PlayButton /></span>
      </button>
      <button
        class="_modal__close"
        type="button"
        aria-label="Закрыть видео"
        popovertarget="popover-people"
        popovertargetaction="hide"
      >
        <CloseIcon />
      </button>
    </div>
  </div>
</div>

<style>
  .people {
    overflow: hidden;

    & .people__title {
      letter-spacing: -1px;

      /* desktop */
      @media (width >= 960px) {
        letter-spacing: -1.5px;
      }

      /* widescreen */
      @media (width >= 1200px) {
        letter-spacing: 0;
      }
    }

    .title-img {
      transform-origin: right top;
      transform: rotate(-15deg) scale(0.75) scale(1);

      /* widescreen */
      @media (width >= 1200px) {
        transform: rotate(-15deg);
        transform-origin: center;
      }
    }

    & .people__marquee {
      display: grid;
      margin-top: 42px;
      padding-bottom: 6px;

      /* desktop */
      @media (width >= 960px) {
        padding-bottom: 60px;
      }
    }

    & .people__row {
      width: 100%;

      &:nth-child(even) .people__track {
        animation-direction: reverse;
      }

      &:hover .people__track {
        animation-play-state: paused;
      }
    }

    & .people__marquee[data-modal-open] .people__track {
      animation-play-state: paused;
    }

    & .people__track {
      display: flex;
      width: max-content;
      will-change: transform;
      animation: people-marquee 45s linear infinite;
    }

    & .people__group {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: 20px;
      padding-right: 20px;
    }

    & .people__photo {
      --people-photo-size: min(77px, 20vh);

      flex-shrink: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      background: transparent;
      width: var(--people-photo-size);
      height: var(--people-photo-size);
      border-radius: 50%;
      border: none;
      overflow: hidden;
      cursor: pointer;
      box-shadow: 0 3px 58px 0 transparent;
      color: #0062ff;
      font-size: 64px;
      font-weight: 700;
      line-height: 1;

      transition:
        background-color var(--transition-long),
        box-shadow var(--transition-long);

      &:hover {
        background: #c9ddff;
        box-shadow: 0 3px 58px 0 #0062ff;
      }
    }

    & .people__photo-image {
      display: block;
      width: 102%;
      height: 102%;
      object-fit: cover;
    }

    @media (prefers-reduced-motion: reduce) {
      & .people__track {
        animation-play-state: paused;
        will-change: auto;
      }
    }

    ._modal {
      --modal-width: 309px;
      --modal-height: 174px;

      position: fixed;
      inset: 0;
      box-sizing: border-box;
      width: var(--modal-width);
      min-width: var(--modal-width);
      max-width: var(--modal-width);
      height: var(--modal-height);
      min-height: var(--modal-height);
      max-height: var(--modal-height);
      margin: auto;
      padding: 0;
      border: 0;
      overflow: visible;
      background-color: transparent;
      opacity: 0;
      transform: scale(0.75);
      transition:
        opacity calc(2 * var(--delay)) var(--timing-func),
        transform calc(2 * var(--delay)) var(--timing-func),
        overlay calc(2 * var(--delay)) var(--timing-func) allow-discrete,
        display calc(2 * var(--delay)) var(--timing-func) allow-discrete;
    }

    ._modal video {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: var(--border-radius20);
      overflow: hidden;
      cursor: pointer;

      /* desktop */
      @media (width >= 960px) {
        border-radius: 32px;
        object-fit: cover;
      }
    }

    ._modal__playback,
    ._modal__close {
      position: absolute;
      display: grid;
      place-items: center;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--color-text-primary);
      cursor: pointer;
    }

    ._modal__playback {
      inset: 0;
      width: 48px;
      height: 48px;
      margin: auto;
      color: var(--color-text-primary);
      transition:
        color var(--transition),
        opacity var(--transition);
    }

    ._modal__playback:hover {
      color: var(--color-text-primary);
    }

    ._modal__play-icon {
      font-size: 0;
      transition:
        opacity var(--transition),
        transform var(--transition);
    }

    @media (hover: none) {
      ._modal[data-playing][data-playback-hidden]
        ._modal__playback:not(:focus-visible) {
        opacity: 0;
      }
    }

    @media (hover: hover) {
      ._modal[data-playing] ._modal__playback:not(:focus-visible) {
        opacity: 0;
      }

      ._modal[data-playing]:hover ._modal__playback {
        opacity: 1;
      }
    }

    ._modal[data-playing] ._modal__play-icon {
      opacity: 0;
      transform: scale(0.25);
    }

    ._modal__close {
      top: var(--space12);
      right: var(--space12);
      width: 19px;
      height: 19px;
    }

    ._modal__close svg {
      width: 100%;
      height: 100%;
    }

    ._modal__playback:focus-visible,
    ._modal__close:focus-visible {
      outline: 2px solid var(--color-text-primary);
      outline-offset: 4px;
    }

    ._modal:popover-open {
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      ._modal:popover-open {
        opacity: 0;
        transform: scale(0.75);
      }
    }

    ._modal::backdrop {
      background-color: rgb(1 4 10 / 70%);
      opacity: 0;
      transition:
        opacity calc(2 * var(--delay)) var(--timing-func),
        overlay calc(2 * var(--delay)) var(--timing-func) allow-discrete,
        display calc(2 * var(--delay)) var(--timing-func) allow-discrete;
    }

    ._modal:popover-open::backdrop {
      opacity: 1;
    }

    @starting-style {
      ._modal:popover-open::backdrop {
        opacity: 0;
      }
    }

    /* desktop */
    @media (width >= 960px) {
      & ._modal {
        --modal-width: 881px;
        --modal-height: 485px;
      }

      & ._modal__close {
        top: var(--space24);
        right: var(--space24);
        width: 14px;
        height: 14px;
      }

      & .people__photo {
        --people-photo-size: min(200px, 20vh);
      }

      & .people__marquee {
        margin-top: 12px;
      }
    }

    /* widescreen */
    @media (width >= 1200px) {
      & ._modal {
        --modal-width: 1120px;
        --modal-height: 657px;
      }

      & .people__photo {
        --people-photo-size: min(250px, 20vh);
      }

      & .people__marquee {
        margin-top: 48px;
      }

      & ._modal__close {
        width: 14px;
        height: 14px;
      }
    }

    /* fullhd */
    @media (width >= 1600px) {
      & .people__photo {
        --people-photo-size: min(287px, 20vh);
      }
    }
  }

  @keyframes people-marquee {
    to {
      transform: translateX(-25%);
    }
  }
</style>
