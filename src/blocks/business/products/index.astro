---
import Title from "../../../components/title.astro";
import Container from "../../../components/container.astro";

import dzenLogo from "./assets/logos/dzen.svg";
import maxLogo from "./assets/logos/max.webp";
import okLogo from "./assets/logos/ok.svg";
import clipsLogo from "./assets/logos/vk-clips.svg";
import musicLogo from "./assets/logos/vk-music.svg";
import videoLogo from "./assets/logos/vk-video.svg";
import vkLogo from "./assets/logos/vk.svg";
import mediaProjectsLogo from "./assets/logos/media-projects.webp";
import discoveryLogo from "./assets/logos/discovery.webp";

import stars1 from "./assets/decor/stars_1.webp";
import stars2 from "./assets/decor/stars_2.webp";
import stars3 from "./assets/decor/stars_3.webp";
import stars4 from "./assets/decor/stars_4.webp";
import stars5 from "./assets/decor/stars_5.webp";
import stars6 from "./assets/decor/stars_6.webp";
import stars7 from "./assets/decor/stars_7.webp";
import stars12 from "./assets/decor/stars_12.webp";
import stars13 from "./assets/decor/stars_13.webp";

type Product = {
  logo: ImageMetadata | string;
  // Logo width at the full HD breakpoint; smaller sizes scale with square logos.
  logoWidth?: number;
  text: string;
  href: string;
};

type RowItem =
  | { type: "product"; product: Product }
  | { type: "decor"; image: ImageMetadata };

const products = {
  video: {
    logo: videoLogo,
    text: "фильмы, трансляции,\nэксклюзивные проекты",
    href: "https://vkvideo.ru/",
  },
  music: {
    logo: musicLogo,
    text: "музыка, аудиокниги,\nподкасты",
    href: "https://vk.ru/music",
  },
  max: {
    logo: maxLogo,
    text: "мессенджер нового\nпоколения",
    href: "https://max.ru/",
  },
  clips: {
    logo: clipsLogo,
    text: "миллионы коротких\nвертикальных видео",
    href: "https://vkclips.app/",
  },
  vk: {
    logo: vkLogo,
    text: "крупнейшая социальная\nсеть в России и СНГ",
    href: "https://vk.com/about",
  },
  ok: {
    logo: okLogo,
    text: "народная соцсеть",
    href: "https://insideok.ru/blog/mediakit-ok-2026-vsyo-samoe-vazhnoe-ob-auditorii-i-vozmozhnostyah-dlya-biznesa/",
  },
  dzen: {
    logo: dzenLogo,
    text: "крупнейшая\nновостная платформа",
    href: "https://dzen.ru/about",
  },
  mediaProjects: {
    logo: mediaProjectsLogo,
    logoWidth: 433,
    text: "крупнейшая информационная\nэкосистема из 17 медиа",
    href: "https://home.vk.team/blog/mediaproektyi-mailru",
  },
  discovery: {
    logo: discoveryLogo,
    logoWidth: 349,
    text: "технологии discovery\nдля рекомендаций, поиска и рекламы",
    href: "https://team.vk.company/projects/315",
  },
} satisfies Record<string, Product>;

const product = (item: Product): RowItem => ({
  type: "product",
  product: item,
});
const decor = (image: ImageMetadata): RowItem => ({ type: "decor", image });

const rows: RowItem[][] = [
  [
    decor(stars2),
    product(products.video),
    decor(stars4),
    product(products.music),
    decor(stars3),
    product(products.max),
  ],
  [
    decor(stars5),
    product(products.clips),
    decor(stars12),
    product(products.mediaProjects),
    decor(stars7),
    product(products.vk),
  ],
  [
    decor(stars6),
    product(products.ok),
    decor(stars1),
    product(products.dzen),
    decor(stars13),
    product(products.discovery),
  ],
];
---

<section class="products" aria-labelledby="products-title">
  <Container>
    <Title title="h3" id="products-title">
      <span class="products__title">То, что&nbsp;мы&nbsp;создаём</span>
    </Title>
  </Container>

  <div class="products__marquee" data-reveal>
    {
      rows.map((row) => (
        <div class="products__row">
          <div class="products__track">
            {[false, true, true, true].map((isDuplicate) => (
              <div
                class="products__group"
                aria-hidden={isDuplicate ? "true" : undefined}
              >
                {row.map((item) =>
                  item.type === "decor" ? (
                    <img
                      class="products__decor"
                      src={item.image.src}
                      alt=""
                      width="72"
                      height="72"
                      loading="lazy"
                    />
                  ) : (
                    <a
                      class:list={[
                        "products__card",
                        {
                          "products__card--wide": Boolean(item.product.logoWidth),
                        },
                      ]}
                      href={item.product.href}
                      target="_blank"
                      rel="noreferrer"
                      tabindex={isDuplicate ? "-1" : undefined}
                    >
                      <img
                        class="products__logo"
                        style={
                          item.product.logoWidth
                            ? `--product-logo-width-factor: ${item.product.logoWidth / 90}`
                            : undefined
                        }
                        src={
                          typeof item.product.logo === "string"
                            ? item.product.logo
                            : item.product.logo.src
                        }
                        alt=""
                        width={
                          typeof item.product.logo === "string"
                            ? 40
                            : item.product.logo.width
                        }
                        height={
                          typeof item.product.logo === "string"
                            ? 40
                            : item.product.logo.height
                        }
                      />
                      <span>{item.product.text}</span>
                    </a>
                  ),
                )}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .products {
    z-index: 1;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      padding-bottom: 80px;
    }

    /* widescreen */
    @media (width >= 1200px) {
      margin-top: -36px;
    }

    /* fullhd */
    @media (width >= 1600px) {
      margin-top: 0;
    }
  }

  & .products__title {
    letter-spacing: -1px;

    /* desktop */
    @media (width >= 960px) {
      letter-spacing: -1.5px;
    }

    /* widescreen */
    @media (width >= 1200px) {
      letter-spacing: -2px;
    }

    /* fullhd */
    @media (width >= 1600px) {
      letter-spacing: 0;
      font-size: 72px;
      line-height: 140%;
    }
  }

  .products__marquee {
    display: grid;
    gap: var(--space16);
    margin-top: 38px;

    /* desktop */
    @media (width >= 960px) {
      gap: var(--space24);
    }

    /* widescreen */
    @media (width >= 1200px) {
      margin-top: 64px;
    }

    /* fullhd */
    @media (width >= 1600px) {
      margin-top: 100px;
    }
  }

  .products__row {
    width: 100%;
    min-width: 0;
  }

  .products__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: products-marquee 45s linear infinite;
  }

  .products__row:nth-child(even) .products__track {
    animation-direction: reverse;
  }

  .products__row:hover:not(:focus-within) .products__track,
  .products__row:has(:focus-visible) .products__track {
    animation-play-state: paused;
  }

  .products__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space8);
    padding-right: var(--space8);

    /* desktop */
    @media (width >= 960px) {
      gap: var(--space24);
      padding-right: var(--space24);
    }
  }

  .products__card {
    --product-logo-size: 40px;
    --product-card-padding: var(--space16);

    font-family: var(--font-secondary), sans-serif;
    line-height: 1.1;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 20px;
    min-height: calc(var(--product-logo-size) + var(--product-card-padding) * 2);
    padding: var(--product-card-padding);
    border-radius: 20px;
    background: #101010;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-primary);
    box-shadow: 0 3px 58.6px 0 transparent;
    transition: box-shadow var(--transition-long) ease;

    /* desktop */
    @media (width >= 960px) {
      --product-logo-size: 70px;
      --product-card-padding: var(--space24);

      font-weight: 500;
      font-size: 24px;
    }

    /* fullhd */
    @media (width >= 1600px) {
      --product-logo-size: 90px;
      --product-card-padding: var(--space40);

      font-size: 32px;
      gap: 36px;
    }

    @media (hover: hover) {
      &:hover {
        box-shadow: 0 3px 58px 0 #0062ff;
      }
    }
  }

  .products__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .products__card span {
    flex: none;
    white-space: pre-line;
  }

  .products__logo {
    display: block;
    width: calc(var(--product-logo-size) * var(--product-logo-width-factor, 1));
    height: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  .products__decor {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    object-fit: contain;

    /* desktop */
    @media (width >= 960px) {
      width: 116px;
      height: 116px;
    }

    /* fullhd */
    @media (width >= 1600px) {
      width: 170px;
      height: 170px;
    }
  }

  @media (width < 768px) {
    .products__group {
      align-items: stretch;
    }

    .products__decor {
      align-self: center;
    }

    .products__card--wide {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space12);
      width: min(280px, calc(100vw - var(--space32)));
    }

    .products__card--wide span {
      flex: initial;
      white-space: normal;
    }
  }

  @keyframes products-marquee {
    to {
      transform: translateX(calc(-100% / var(--products-repeat-count, 4)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .products__track {
      animation-play-state: paused;
      will-change: auto;
    }
  }
</style>
